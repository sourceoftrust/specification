---
import Base from './Base.astro';
import { initiative, editor } from '../data/initiative.js';
const { frontmatter, headings } = Astro.props;
const displayDate = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(frontmatter.date));
---
<Base title={frontmatter.title} description={frontmatter.description} canonicalPath="/specification/source-of-trust/" article date={frontmatter.date} firstPublishedDate={frontmatter.firstPublishedDate} version={frontmatter.version}>
<div class="spec-layout">
<aside class="toc"><nav aria-label="Table of contents"><h2>Contents</h2><ol>{headings.filter(h => h.depth === 2).map(h => <li><a href={'#' + h.slug}>{h.text}</a></li>)}</ol></nav></aside>
<main id="main" class="spec"><header class="document-header"><p class="eyebrow">Open Specification</p><h1>{frontmatter.title}</h1><p class="document-status">Editor's Draft · Version {frontmatter.version} · <time datetime={frontmatter.date}>{displayDate}</time></p>
<dl class="metadata"><dt>Published by</dt><dd><a href="/about/">{initiative.name} ({initiative.alternateName})</a></dd><dt>Editor</dt><dd><a href="/about/#stefan-mayr">{editor.name}</a></dd><dt>Latest Version URL</dt><dd><a href="https://sourceoftrust.org/specification/source-of-trust/">https://sourceoftrust.org/specification/source-of-trust/</a></dd><dt>GitHub Repository</dt><dd><a href="https://github.com/sourceoftrust/specification">sourceoftrust/specification</a></dd><dt>Version Snapshot</dt><dd>{frontmatter.releaseTag === false ? 'Prepared draft; version snapshot pending publication.' : <a href={`https://github.com/sourceoftrust/specification/tree/v${frontmatter.version}`}>Version {frontmatter.version} in Git</a>}</dd><dt>Feedback</dt><dd><a href="https://github.com/sourceoftrust/specification/issues">GitHub Issues</a></dd><dt>Content License</dt><dd><a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0 1.0 Universal</a></dd></dl></header><article><slot /></article></main>
</div>
</Base>

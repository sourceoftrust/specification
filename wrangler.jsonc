{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sourceoftrust-specification",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    {
      "pattern": "sourceoftrust.org",
      "custom_domain": true
    },
    {
      "pattern": "www.sourceoftrust.org",
      "custom_domain": true
    }
  ]
}
